{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "outDir": "out",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"]
    },
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/shared/utils/money.ts", "src/shared/utils/gst-presentation.ts", "src/shared/data/tax-presets.ts", "src/shared/data/tds-sections.ts", "src/renderer/src/shared/utils/cart-totals.util.ts", "src/renderer/src/shared/utils/tax.util.ts", "src/renderer/src/shared/utils/off-slab-rate.util.ts", "src/renderer/src/shared/utils/money-context.util.ts", "src/main/**/*.json", "src/preload/**/*", "electron.vite.config.ts", "vitest.config.ts"]
}
