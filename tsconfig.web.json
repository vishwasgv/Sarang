{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@money": ["src/shared/utils/money.ts"],
      "@gst": ["src/shared/utils/gst-presentation.ts"],
      "@taxpresets": ["src/shared/data/tax-presets.ts"],
      "@tds": ["src/shared/data/tds-sections.ts"],
      "@taxparts": ["src/shared/utils/tax-components.ts"],
      "@shared/*": ["src/renderer/src/shared/*"],
      "@modules/*": ["src/renderer/src/modules/*"],
      "@app/*": ["src/renderer/src/app/*"],
      "@assets/*": ["src/renderer/src/assets/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/main/ipc/channels.ts", "src/shared/utils/money.ts", "src/shared/utils/gst-presentation.ts", "src/shared/data/tax-presets.ts", "src/shared/data/tds-sections.ts", "src/shared/utils/tax-components.ts"]
}
